# Copy this file to `secrets.toml` (same folder) and fill in your key.
# secrets.toml is gitignored so your key is never committed.

# Required for the 🤖 Assistant tab (natural-language setlist generation).
# Get a FREE key at https://aistudio.google.com/apikey
GEMINI_API_KEY = "..."

